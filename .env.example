# -------------------- Mail routing --------------------
# Public MX hostname used by Postfix and certbot.
SMTP_HOSTNAME=mx.example.com

# Postfix TLS mode: real, external, self-signed, or disabled.
# Use self-signed for local development without ACME.
SMTP_TLS_MODE=real

# Certificate chain file used by SMTP_TLS_MODE=external.
# SMTP_TLS_CHAIN_FILE=/certs/smtp.pem

# Optional validity period for self-signed development certificates.
# SELF_SIGNED_CERT_DAYS=7

# Only mail for this domain is accepted.
ACCEPTED_RCPT_DOMAIN=example.com

# Maximum accepted message size in bytes.
MAX_MESSAGE_BYTES=10485760

# Optional inbound SMTP hardening.
# Rate window for per-client connection tracking.
# ANVIL_RATE_TIME_UNIT=60s
# Maximum simultaneous connections per client IP.
# SMTPD_CLIENT_CONNECTION_COUNT_LIMIT=20
# Maximum new connections per client IP within the rate window.
# SMTPD_CLIENT_CONNECTION_RATE_LIMIT=60
# Per-command SMTP timeout to reduce slow-client abuse.
# SMTPD_TIMEOUT=60s


# -------------------- Processor --------------------
# Require at least one attachment.
REQUIRE_ATTACHMENTS=true

# Maximum number of attachments per message.
MAX_ATTACHMENTS=1

# Allowed attachment extensions.
ALLOWED_ATTACHMENT_EXTENSIONS=.xml,.zip,.gz,.gzip

# Maximum extracted XML size in bytes.
MAX_XML_BYTES=10485760

# Maximum allowed archive compression ratio.
MAX_COMPRESSION_RATIO=60

# ClamAV integration used by the processor.
# CLAMAV_SCAN_ENABLED=true
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=10000

# Optional worker tuning.
# PROCESSOR_INPUT_DIR=/maildrop/incoming
# PROCESSOR_POLL_MS=1000
# PROCESSOR_RETRY_DELAY_MS=30000
# PROCESSOR_MAX_RETRIES=20
# PROCESSOR_MAX_BATCH_SIZE=10
# PROCESSOR_DEAD_LETTER_DIR=/maildrop/dead-letter
# PROCESSOR_HEARTBEAT_PATH=/tmp/mail-inbound-webhook/processor.heartbeat
# PROCESSOR_HEALTHCHECK_STALE_MS=30000
# PROCESSOR_METRICS_LOG_MS=60000


# -------------------- Webhook --------------------
WEBHOOK_URL=https://app.example.com/inbound-email
WEBHOOK_TIMEOUT_MS=4000


# -------------------- S3 / Object storage --------------------
S3_ENDPOINT=https://s3.example.com
S3_REGION=eu-central-1
S3_BUCKET=mail
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_TIMEOUT_MS=30000


# -------------------- Certbot --------------------
CERT_EMAIL=ops@example.com


# -------------------- Secrets (Docker /run/secrets) --------------------
# These values are read from files, not from env vars:
# - /run/secrets/webhook_secret
# - /run/secrets/s3_access_key
# - /run/secrets/s3_secret_key
# - /run/secrets/cloudflare_api_token
